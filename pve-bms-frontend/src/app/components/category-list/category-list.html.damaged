
$file = ".\src\app\components\category-list\category-list.html"

$content = Get-Content $file -Raw

$old = @'
      <a class="nav-item">
        <span>▣</span> Products
      </a>
'@

$new = @'
      <a class="nav-item">
        <span>▣</span> Products
      </a>

      <a class="nav-item barcode-nav-item" href="/product-lookup">
        <span>▥</span> Barcode Lookup
      </a>
'@

if ($content.Contains($old)) {
    Copy-Item $file "$file.backup"
    $content = $content.Replace($old, $new)
    Set-Content -Path $file -Value $content -Encoding UTF8
    Write-Host "Barcode Lookup menu added successfully!" -ForegroundColor Green
} else {
    Write-Host "Products menu section not found. No changes made." -ForegroundColor Red
}
