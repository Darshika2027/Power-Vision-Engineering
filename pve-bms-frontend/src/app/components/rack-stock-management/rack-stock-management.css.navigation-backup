:host {
  display: block;
  min-height: 100%;
  color: #e8edf7;
  font-family: Arial, sans-serif;
}

.rack-page {
  padding: 30px;
  background: #0b1120;
  min-height: 100vh;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 28px;
}

.breadcrumb { color: #8c9ab3; font-size: 13px; margin-bottom: 12px; }
.page-header h1 { font-size: 27px; margin: 0 0 8px; font-weight: 700; }
.page-header p, .section-heading p, .table-header p { color: #8997af; font-size: 13px; margin: 0; }

.primary-btn {
  background: #356df3;
  border: 1px solid #477cff;
  color: white;
  padding: 12px 18px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  transition: 0.2s;
}
.primary-btn:hover { background: #2458d6; }

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 34px;
}

.summary-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 22px;
  border-radius: 12px;
  background: #141e31;
  border: 1px solid #243149;
}

.summary-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  font-size: 23px;
  flex-shrink: 0;
}

.blue { background: #183a75; color: #6ca2ff; }
.purple { background: #39265f; color: #c3a0ff; }
.green { background: #174b3b; color: #62d6a3; }
.orange { background: #593b20; color: #ffb46a; }

.summary-card p { color: #9ba9c0; font-size: 13px; margin: 0 0 7px; }
.summary-card h2 { font-size: 25px; margin: 0 0 5px; }
.summary-card span { color: #71819b; font-size: 11px; }

.section-heading { margin-bottom: 17px; }
.section-heading h2, .table-header h2 { font-size: 18px; margin: 0 0 7px; }

.location-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 30px;
}

.location-card {
  background: #141e31;
  border: 1px solid #243149;
  border-radius: 12px;
  padding: 20px;
}

.location-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.location-icon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background: #1c3155;
  display: grid;
  place-items: center;
  font-size: 20px;
}

.location-tag {
  font-size: 11px;
  color: #8fb4ff;
  background: #1b3155;
  border-radius: 20px;
  padding: 6px 11px;
}

.location-card h3 { margin: 0 0 7px; font-size: 16px; }
.location-card p { color: #8796ad; font-size: 12px; margin: 0 0 18px; }

.location-bottom {
  border-top: 1px solid #28364c;
  padding-top: 13px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.location-bottom strong { font-size: 20px; color: #75a1ff; }
.location-bottom span { color: #8796ad; font-size: 12px; }

.table-section {
  background: #141e31;
  border: 1px solid #243149;
  border-radius: 12px;
  overflow: hidden;
}

.table-header {
  padding: 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.record-count {
  color: #9cbcff;
  background: #1b3155;
  padding: 7px 12px;
  border-radius: 20px;
  font-size: 12px;
}

.filter-bar {
  padding: 0 22px 20px;
  display: flex;
  gap: 12px;
  align-items: center;
}

.search-box {
  display: flex;
  align-items: center;
  flex: 1;
  background: #0d1729;
  border: 1px solid #2b3a54;
  border-radius: 8px;
  padding: 0 13px;
}

.search-box span { font-size: 22px; color: #8496b3; }
.search-box input {
  width: 100%;
  padding: 12px;
  background: transparent;
  border: none;
  outline: none;
  color: white;
}

.filter-bar select, .form-group select {
  min-width: 160px;
  padding: 12px;
  background: #0d1729;
  border: 1px solid #2b3a54;
  color: #e8edf7;
  border-radius: 8px;
}

.secondary-btn {
  padding: 11px 14px;
  border: 1px solid #35445e;
  color: #c1ccdd;
  background: #1b2940;
  border-radius: 8px;
  cursor: pointer;
}
.secondary-btn:hover { background: #263751; }

.table-responsive { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; min-width: 1000px; }
thead { background: #101a2c; }

th {
  text-align: left;
  padding: 15px 17px;
  color: #8292ac;
  font-size: 10px;
  letter-spacing: 0.7px;
  white-space: nowrap;
}

td {
  padding: 17px;
  border-top: 1px solid #25334a;
  color: #c2ccdc;
  font-size: 12px;
  white-space: nowrap;
}

tbody tr:hover { background: #19263b; }

.rack-code {
  background: #1b3155;
  color: #8fb4ff;
  border-radius: 5px;
  padding: 7px 9px;
  font-weight: 600;
}

.product-cell { display: flex; flex-direction: column; gap: 5px; }
.product-cell strong { color: #e9eef8; font-size: 12px; }
.product-cell span, .unit { color: #8190a8; font-size: 11px; }
.location-label { color: #a9b8d1; }
.quantity { color: #e8edf7; }

.status {
  display: inline-block;
  border-radius: 20px;
  padding: 6px 10px;
  font-size: 10px;
  font-weight: 600;
}
.in-stock { color: #63d6a2; background: #174534; }
.low-stock { color: #ffbf72; background: #50391f; }
.out-stock { color: #ff8585; background: #512b32; }

.action-buttons { display: flex; gap: 7px; }
.icon-btn {
  width: 30px;
  height: 30px;
  border-radius: 6px;
  border: 1px solid #34445e;
  cursor: pointer;
  background: #1b2940;
  font-size: 16px;
}
.edit-btn { color: #8fb4ff; }
.delete-btn { color: #ff8585; }

.empty-state { text-align: center; padding: 50px 15px; color: #aab7ca; }
.empty-state p { color: #8292ac; }
.empty-icon { font-size: 30px; margin-bottom: 12px; }

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(3, 8, 18, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal-box {
  width: 100%;
  max-width: 570px;
  background: #141e31;
  border: 1px solid #35445e;
  border-radius: 14px;
  box-shadow: 0 20px 70px rgba(0, 0, 0, 0.45);
}

.modal-header {
  padding: 23px;
  border-bottom: 1px solid #2a3950;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.modal-header h2 { margin: 0 0 7px; font-size: 19px; }
.modal-header p { color: #8997af; font-size: 12px; margin: 0; }
.close-btn { color: #aab7ca; background: transparent; border: none; font-size: 25px; cursor: pointer; }
.modal-body { padding: 23px; }

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 17px;
  flex: 1;
}
.form-group label { font-size: 12px; color: #aebbd0; font-weight: 600; }
.form-group input {
  width: 100%;
  box-sizing: border-box;
  padding: 12px;
  background: #0d1729;
  border: 1px solid #30405a;
  border-radius: 7px;
  color: white;
  outline: none;
}
.form-group input:focus, .form-group select:focus { border-color: #477cff; }
.form-row { display: flex; gap: 15px; }

.modal-footer {
  border-top: 1px solid #2a3950;
  padding: 18px 23px;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

@media (max-width: 1100px) {
  .summary-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 750px) {
  .rack-page { padding: 17px; }
  .page-header { align-items: flex-start; flex-direction: column; }
  .location-grid { grid-template-columns: 1fr; }
  .filter-bar { flex-direction: column; align-items: stretch; }
  .filter-bar select { width: 100%; }
  .form-row { flex-direction: column; gap: 0; }
}

@media (max-width: 480px) {
  .summary-grid { grid-template-columns: 1fr; }
  .table-header { align-items: flex-start; flex-direction: column; }
}

/* CATEGORY MANAGEMENT MATCHING SIDEBAR */

:host {
  display: block;
  width: 100%;
}

.app-layout {
  display: flex;
  min-height: 100vh;
  background: #f5f7fc;
  color: #1a3159;
  font-family: Arial, sans-serif;
}

.sidebar {
  width: 245px;
  min-width: 245px;
  min-height: 100vh;
  padding: 25px 17px;
  background: #091b3d;
  color: white;
  display: flex;
  flex-direction: column;
}

.sidebar .brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 5px 5px 35px;
}

.sidebar .brand-logo {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #1688f5, #6550e9);
  font-weight: 800;
  font-size: 13px;
}

.sidebar .brand h2 {
  margin: 0 0 5px;
  font-size: 17px;
}

.sidebar .brand span {
  color: #9aabc9;
  font-size: 10px;
}

.sidebar .nav-label {
  color: #7185a8;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  padding: 0 10px 13px;
}

.sidebar .navigation {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.sidebar .nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 12px;
  border-radius: 9px;
  color: #aebbd2;
  text-decoration: none;
  font-size: 12px;
  cursor: pointer;
  transition: 0.2s ease;
}

.sidebar .nav-item > span:first-child {
  width: 21px;
  font-size: 17px;
  text-align: center;
}

.sidebar .nav-item.active {
  color: white;
  background: linear-gradient(100deg, #176fe4, #5149d9);
}

.sidebar .nav-item:hover {
  background: #ffffff12;
  color: white;
}

.sidebar .sidebar-bottom {
  margin-top: auto;
  padding-top: 30px;
}

.sidebar .sidebar-message {
  padding: 18px;
  background: #ffffff0c;
  border: 1px solid #ffffff15;
  border-radius: 12px;
}

.sidebar .message-icon {
  color: #65baff;
  font-size: 22px;
}

.sidebar .sidebar-message h3 {
  font-size: 14px;
  margin: 10px 0 5px;
}

.sidebar .sidebar-message p {
  color: #9aabc9;
  font-size: 11px;
  margin: 0;
}

.sidebar .version {
  display: block;
  text-align: center;
  color: #7185a8;
  font-size: 9px;
  margin-top: 15px;
}

.app-layout > .main-content {
  flex: 1;
  min-width: 0;
  padding: 0 30px;
  overflow: hidden;
}

@media (max-width: 760px) {
  .sidebar {
    width: 68px;
    min-width: 68px;
    padding: 20px 8px;
  }

  .sidebar .brand {
    justify-content: center;
    padding: 5px 0 30px;
  }

  .sidebar .brand > div:last-child,
  .sidebar .nav-label,
  .sidebar .nav-item {
    font-size: 0;
  }

  .sidebar .nav-item {
    justify-content: center;
    padding: 13px 5px;
  }

  .sidebar .nav-item > span:first-child {
    font-size: 19px;
  }

  .sidebar .sidebar-bottom {
    display: none;
  }

  .app-layout > .main-content {
    padding: 0 12px;
  }
}