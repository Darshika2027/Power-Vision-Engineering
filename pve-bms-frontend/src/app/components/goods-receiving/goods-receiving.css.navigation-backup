:host {
  display: block;
  min-height: 100vh;
  background: #f3f6fc;
  color: #172b4d;
  font-family: "Segoe UI", Arial, sans-serif;
}

/* TOP BAR */
.topbar {
  min-height: 62px;
  padding: 0 4%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-bottom: 1px solid #e8edf5;
}

.breadcrumb {
  color: #8995a9;
  font-size: 12px;
  margin-right: 8px;
}

.topbar strong {
  color: #172b4d;
  font-size: 13px;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 22px;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #68778e;
  font-size: 12px;
}

.online-dot {
  width: 8px;
  height: 8px;
  background: #20bd83;
  border-radius: 50%;
}

/* HERO */
.hero {
  position: relative;
  overflow: hidden;
  min-height: 205px;
  margin: 30px 4% 25px;
  padding: 38px 42px;
  display: flex;
  align-items: center;
  border-radius: 18px;
  background: linear-gradient(115deg, #10284c 0%, #194779 65%, #24639a 100%);
  color: #ffffff;
  box-shadow: 0 12px 30px rgba(22, 54, 94, 0.13);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 620px;
}

.hero-tag {
  display: inline-block;
  padding: 7px 11px;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 20px;
  background: rgba(255,255,255,.08);
  color: #ffb477;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.hero h1 {
  margin: 15px 0 9px;
  font-size: 36px;
  line-height: 1.2;
  font-weight: 750;
  letter-spacing: -.8px;
}

.hero h1 span {
  color: #ffad70;
}

.hero p {
  max-width: 540px;
  margin: 0;
  color: #d1deed;
  font-size: 13px;
  line-height: 1.8;
}

.hero-line {
  width: 48px;
  height: 3px;
  margin-top: 19px;
  border-radius: 5px;
  background: #ff9d59;
}

.hero-decoration {
  position: absolute;
  top: 0;
  right: 65px;
  width: 230px;
  height: 100%;
  pointer-events: none;
}

.hero-orbit {
  position: absolute;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 50%;
}

.orbit-one {
  width: 190px;
  height: 190px;
  top: 7px;
  right: 0;
}

.orbit-two {
  width: 145px;
  height: 145px;
  top: 29px;
  right: 22px;
}

.hero-box {
  position: absolute;
  top: 69px;
  right: 82px;
  width: 62px;
  height: 62px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.28);
  border-radius: 15px;
  background: rgba(255,255,255,.12);
  color: #ffb477;
  font-size: 29px;
  backdrop-filter: blur(5px);
}

.hero-small {
  position: absolute;
  top: 42px;
  right: 43px;
  color: #ffb477;
  font-size: 22px;
}

/* STATISTICS */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin: 0 4% 25px;
}

.stat-card {
  position: relative;
  min-height: 112px;
  padding: 21px 23px;
  display: flex;
  align-items: center;
  gap: 16px;
  background: #ffffff;
  border: 1px solid #e9eef6;
  border-radius: 14px;
  box-shadow: 0 5px 18px rgba(29, 55, 91, .035);
  transition: transform .2s ease, box-shadow .2s ease;
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(29, 55, 91, .08);
}

.stat-icon {
  width: 49px;
  height: 49px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 14px;
  font-size: 21px;
  font-weight: 700;
}

.stat-blue .stat-icon {
  color: #3978d4;
  background: #edf4ff;
}

.stat-green .stat-icon {
  color: #1eaa79;
  background: #e9f8f1;
}

.stat-orange .stat-icon {
  color: #e48a3c;
  background: #fff3e8;
}

.stat-info span {
  color: #7c899e;
  font-size: 11px;
  font-weight: 600;
}

.stat-info h2 {
  margin: 6px 0 4px;
  color: #192e50;
  font-size: 26px;
  line-height: 1;
}

.stat-info small {
  color: #a0aabd;
  font-size: 10px;
}

/* MAIN WORKSPACE */
.workspace {
  margin: 0 4% 40px;
  padding: 30px;
  background: #ffffff;
  border: 1px solid #e8edf5;
  border-radius: 16px;
  box-shadow: 0 7px 25px rgba(29, 55, 91, .04);
}

.workspace-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 24px;
  border-bottom: 1px solid #edf1f6;
}

.section-kicker {
  color: #e78a46;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.workspace-header h2 {
  margin: 8px 0 6px;
  color: #192e50;
  font-size: 22px;
  font-weight: 700;
}

.workspace-header p,
.section-heading p,
.summary-section p {
  margin: 0;
  color: #8b98ac;
  font-size: 11px;
  line-height: 1.7;
}

.receiving-status {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 14px;
  border: 1px solid #ffe5c8;
  border-radius: 30px;
  background: #fff8ef;
  color: #d98236;
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
}

.receiving-status span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #e99443;
}

/* FORM SECTIONS */
.form-section {
  padding: 27px 0;
  border-bottom: 1px solid #edf1f6;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 21px;
}

.heading-icon {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border: 1px solid #e1ebfc;
  border-radius: 11px;
  background: #f0f5ff;
  color: #3978d4;
  font-size: 11px;
  font-weight: 800;
}

.section-heading h3 {
  margin: 0 0 5px;
  color: #203653;
  font-size: 14px;
  font-weight: 700;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 19px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-group label {
  color: #53647e;
  font-size: 11px;
  font-weight: 650;
}

.form-group label span,
.receiving-table th span {
  color: #e56d60;
}

.form-group input,
.form-group textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 13px;
  border: 1px solid #dfe6f0;
  border-radius: 8px;
  outline: none;
  background: #ffffff;
  color: #263b59;
  font-family: inherit;
  font-size: 11px;
  transition: border-color .2s, box-shadow .2s, background .2s;
}

.form-group input:hover,
.form-group textarea:hover {
  border-color: #b8c8df;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: #5289d9;
  background: #fcfdff;
  box-shadow: 0 0 0 3px rgba(82,137,217,.10);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #aeb8c8;
}

/* PRODUCT TABLE */
.table-wrapper {
  width: 100%;
  overflow-x: auto;
  border: 1px solid #e9eef5;
  border-radius: 10px;
}

.receiving-table {
  width: 100%;
  min-width: 950px;
  border-collapse: collapse;
  text-align: left;
}

.receiving-table thead {
  background: #f5f8fc;
}

.receiving-table th {
  padding: 14px 10px;
  color: #63738d;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .3px;
  white-space: nowrap;
}

.receiving-table td {
  padding: 11px 7px;
  border-top: 1px solid #edf1f6;
  color: #53647e;
  font-size: 10px;
}

.receiving-table tbody tr:hover {
  background: #fbfcff;
}

.receiving-table input {
  width: 100%;
  min-width: 85px;
  box-sizing: border-box;
  padding: 10px 8px;
  border: 1px solid #e2e8f1;
  border-radius: 7px;
  outline: none;
  background: #ffffff;
  color: #263b59;
  font-family: inherit;
  font-size: 10px;
  transition: border-color .2s, box-shadow .2s;
}

.receiving-table input:focus {
  border-color: #5289d9;
  box-shadow: 0 0 0 2px rgba(82,137,217,.09);
}

.receiving-table input::placeholder {
  color: #b0bac8;
}

.row-number {
  color: #8997aa !important;
  font-weight: 700;
}

.subtotal {
  color: #18815f !important;
  font-weight: 750;
  white-space: nowrap;
}

.remove-button {
  width: 29px;
  height: 29px;
  display: grid;
  place-items: center;
  border: 1px solid #ffe1de;
  border-radius: 7px;
  background: #fff5f4;
  color: #d85f58;
  font-size: 18px;
  cursor: pointer;
  transition: .2s;
}

.remove-button:hover:not(:disabled) {
  background: #ffe5e2;
}

.remove-button:disabled {
  opacity: .35;
  cursor: not-allowed;
}

/* ADD PRODUCT */
.add-item-button {
  margin-top: 15px;
  padding: 10px 15px;
  border: 1px dashed #9bb9e5;
  border-radius: 8px;
  background: #f5f8ff;
  color: #3978d4;
  font-size: 10px;
  font-weight: 750;
  cursor: pointer;
  transition: .2s;
}

.add-item-button:hover {
  border-color: #3978d4;
  background: #edf4ff;
}

.add-item-button span {
  margin-right: 6px;
  font-size: 16px;
  vertical-align: -1px;
}

/* NOTES */
.notes-group {
  max-width: 100%;
}

.form-group textarea {
  min-height: 90px;
  resize: vertical;
}

/* RECEIVING SUMMARY */
.summary-section {
  margin-top: 25px;
  padding: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  border: 1px solid #e3ebf7;
  border-radius: 12px;
  background: linear-gradient(110deg, #f7faff, #f9fbfe);
}

.summary-section h3 {
  margin: 8px 0 6px;
  color: #203653;
  font-size: 17px;
}

.summary-details {
  display: flex;
  align-items: center;
  gap: 30px;
}

.summary-item {
  min-width: 90px;
}

.summary-item span,
.summary-item strong {
  display: block;
}

.summary-item span {
  margin-bottom: 8px;
  color: #8794a8;
  font-size: 10px;
}

.summary-item strong {
  color: #263b59;
  font-size: 16px;
}

.summary-total strong {
  color: #17815f;
  font-size: 18px;
}

/* FEEDBACK MESSAGES */
.message {
  margin-top: 18px;
  padding: 13px 15px;
  display: flex;
  align-items: center;
  gap: 10px;
  border-radius: 8px;
  font-size: 11px;
  line-height: 1.6;
}

.error-message {
  border: 1px solid #ffd9d4;
  background: #fff5f3;
  color: #c34e43;
}

.success-message {
  border: 1px solid #ccebdc;
  background: #f0faf5;
  color: #21845f;
}

.message span {
  font-weight: 800;
}

/* FORM ACTIONS */
.form-actions {
  margin-top: 25px;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

.primary-button,
.secondary-button {
  min-height: 42px;
  padding: 0 19px;
  border-radius: 8px;
  font-family: inherit;
  font-size: 10px;
  font-weight: 750;
  cursor: pointer;
  transition: transform .2s, box-shadow .2s, background .2s;
}

.primary-button {
  border: 1px solid #e98340;
  background: linear-gradient(110deg, #f09a55, #e77c36);
  color: #ffffff;
  box-shadow: 0 5px 12px rgba(231,124,54,.17);
}

.primary-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 16px rgba(231,124,54,.24);
}

.primary-button span {
  margin-left: 9px;
}

.secondary-button {
  border: 1px solid #dce4ef;
  background: #ffffff;
  color: #65758d;
}

.secondary-button:hover {
  background: #f5f8fc;
}

.demo-notice {
  margin: 16px 0 0;
  color: #98a4b5;
  font-size: 10px;
  line-height: 1.6;
  text-align: right;
}

/* RESPONSIVE */
@media (max-width: 1000px) {
  .hero,
  .stats-grid,
  .workspace {
    margin-left: 3%;
    margin-right: 3%;
  }

  .summary-section {
    align-items: flex-start;
    flex-direction: column;
  }

  .summary-details {
    width: 100%;
    justify-content: space-between;
    flex-wrap: wrap;
  }
}

@media (max-width: 750px) {
  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .form-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-decoration {
    right: -35px;
    opacity: .6;
  }

  .workspace {
    padding: 22px;
  }
}

@media (max-width: 520px) {
  .topbar {
    padding: 12px 18px;
  }

  .hero {
    min-height: 175px;
    margin: 18px 14px;
    padding: 25px 22px;
  }

  .hero h1 {
    font-size: 27px;
  }

  .hero p {
    max-width: 90%;
    font-size: 11px;
  }

  .hero-decoration {
    right: -125px;
    opacity: .35;
  }

  .stats-grid {
    grid-template-columns: 1fr;
    margin: 0 14px 20px;
    gap: 12px;
  }

  .workspace {
    margin: 0 14px 25px;
    padding: 18px;
  }

  .workspace-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .summary-details {
    align-items: flex-start;
    flex-direction: column;
    gap: 17px;
  }

  .form-actions {
    flex-direction: column-reverse;
  }

  .form-actions button {
    width: 100%;
  }

  .demo-notice {
    text-align: left;
  }
}
/* ===== SIDEBAR LAYOUT ===== */

.app-layout {
  display: flex;
  min-height: 100vh;
  width: 100%;
}

.sidebar {
  width: 250px;
  min-width: 250px;
  min-height: 100vh;
  background: #10233f;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  padding: 25px 16px;
  box-sizing: border-box;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 5px 8px 30px;
}

.brand-logo {
  width: 45px;
  height: 45px;
  border-radius: 12px;
  background: #f39a35;
  color: #10233f;
  display: grid;
  place-items: center;
  font-weight: 900;
  font-size: 17px;
}

.brand h2 {
  color: #ffffff;
  font-size: 19px;
  font-weight: 800;
  margin: 0 0 4px;
}

.brand span {
  color: #bdcce0;
  font-size: 11px;
}

.nav-label {
  color: #91a6c1;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
  padding: 12px 10px;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.nav-item {
  display: block;
  padding: 13px 12px;
  border-radius: 8px;
  color: #dce6f3;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  transition: 0.2s;
}

.nav-item:hover,
.nav-item.active {
  background: #25466d;
  color: #ffffff;
}

.nav-item.active {
  border-left: 4px solid #f39a35;
  font-weight: 800;
}

.sidebar-bottom {
  margin-top: auto;
  padding-top: 30px;
}

.sidebar-message {
  background: #1b385b;
  border-radius: 12px;
  padding: 16px;
  text-align: center;
}

.sidebar-message h3 {
  color: #ffffff;
  font-size: 16px;
  font-weight: 800;
  margin: 8px 0 4px;
}

.sidebar-message p {
  color: #c5d4e7;
  font-size: 13px;
  margin: 0;
}

.message-icon {
  color: #f5a044;
  font-size: 22px;
}

.version {
  display: block;
  color: #91a6c1;
  font-size: 10px;
  text-align: center;
  margin-top: 18px;
}

.main-content {
  flex: 1;
  min-width: 0;
}

/* ===== CLEARER TEXT ===== */

.main-content h1,
.main-content h2,
.main-content h3,
.main-content strong,
.main-content label {
  font-weight: 800;
}

.main-content label {
  color: #172b4d;
  font-size: 14px;
}

.main-content input,
.main-content select,
.main-content textarea {
  color: #172b4d;
  font-weight: 600;
}

.main-content input::placeholder,
.main-content textarea::placeholder {
  color: #78869a;
  opacity: 1;
}

/* ===== DARK BUTTONS ===== */

.main-content button {
  font-weight: 800;
}

.main-content .primary-button,
.main-content .secondary-button,
.main-content .add-item-button {
  background: #102d50;
  color: #ffffff;
  border: 1px solid #102d50;
}

.main-content .primary-button:hover,
.main-content .secondary-button:hover,
.main-content .add-item-button:hover {
  background: #254d78;
  color: #ffffff;
}

.main-content .remove-button {
  background: #26384d;
  color: #ffffff;
  border: 1px solid #26384d;
}

.main-content .remove-button:hover {
  background: #40546c;
}

/* ===== RESPONSIVE ===== */

@media (max-width: 750px) {
  .app-layout {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    min-width: 0;
    min-height: auto;
    padding: 15px;
  }

  .sidebar-bottom {
    display: none;
  }

  .navigation {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .nav-item {
    padding: 10px;
    font-size: 12px;
  }

  .main-content {
    width: 100%;
  }
}
